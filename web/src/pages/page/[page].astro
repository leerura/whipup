---
import Listing from '../../components/Listing.astro';
import { pageCount } from '../../lib/data';

export function getStaticPaths() {
  const pages = pageCount();
  return Array.from({ length: Math.max(0, pages - 1) }, (_, i) => ({ params: { page: String(i + 2) } }));
}
const page = Number(Astro.params.page);
---
<Listing page={page} />
