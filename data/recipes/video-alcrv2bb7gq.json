  "steps": [
    {
      "text": "지방이 적은 돼지고기 앞다리살(전지살) 또는 뒷다리살(후지살)을 준비한다.",
      "evidences": [
        {
          "type": "SPEECH",
          "text": "지방이 적은 전지살이나 후지살 쓰고",
