      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "whippy-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(100.0*count(*) FILTER (WHERE onboarding_completed)/NULLIF(count(*),0),0) AS value FROM users WHERE $__timeFilter(created_at)"
        }
      ],
