      "title": "온보딩 완료율 (기간 내 가입자)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "whippy-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
