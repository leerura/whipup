    {
      "id": 5,
      "type": "barchart",
      "title": "단위별 가입 수",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "whippy-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "whippy-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT (date_trunc('$unit', created_at AT TIME ZONE 'Asia/Seoul')) AT TIME ZONE 'Asia/Seoul' AS time, count(*) AS \"가입\"\nFROM users WHERE $__timeFilter(created_at)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#FF4900"
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "time",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        },
