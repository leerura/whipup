    {
      "id": 7,
      "type": "timeseries",
      "title": "누적 가입자",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "whippy-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "whippy-postgres"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT time, cum AS \"누적 가입자\" FROM (\n  SELECT time, sum(c) OVER (ORDER BY time) AS cum FROM (\n    SELECT (date_trunc('$unit', created_at AT TIME ZONE 'Asia/Seoul')) AT TIME ZONE 'Asia/Seoul' AS time, count(*) AS c FROM users GROUP BY 1\n  ) a\n) b WHERE $__timeFilter(time) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#FF4900"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
